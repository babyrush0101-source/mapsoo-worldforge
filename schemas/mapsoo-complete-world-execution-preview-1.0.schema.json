{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-complete-world-execution-preview-1.0.schema.json",
  "title": "Mapsoo Complete World Execution Preview 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "session_id",
    "authorization_sha256",
    "workflow_id",
    "plan_id",
    "profile",
    "start_state_revision",
    "input_binding_sha256",
    "scope",
    "authorized_task_ids",
    "maximum_remote_requests",
    "workflow_requests_remaining",
    "executable",
    "retry_policy",
    "scene_direction_requires_separate_human_approval",
    "production_art_only",
    "runtime_ready"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "complete-world-execution-preview" },
    "session_id": {
      "type": "string",
      "pattern": "^world-execution-[a-f0-9]{16}$"
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workflow_id": { "$ref": "#/$defs/id" },
    "plan_id": { "$ref": "#/$defs/id" },
    "profile": {
      "enum": [
        "side-platformer",
        "topdown-farm",
        "isometric-action",
        "layered-depth-2d"
      ]
    },
    "start_state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "start_next_task_id": { "$ref": "#/$defs/id" },
    "input_binding_sha256": { "$ref": "#/$defs/sha256" },
    "direction_binding_sha256": { "$ref": "#/$defs/sha256" },
    "scope": {
      "enum": ["scene-direction-only", "remaining-world", "none"]
    },
    "authorized_task_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "maximum_remote_requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "workflow_requests_remaining": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "executable": { "type": "boolean" },
    "block_reason": {
      "enum": [
        "direction-approval-required",
        "scene-direction-review-required",
        "task-review-required",
        "workflow-running",
        "budget-insufficient",
        "budget-exhausted",
        "already-complete"
      ]
    },
    "retry_policy": { "const": "never" },
    "scene_direction_requires_separate_human_approval": { "const": true },
    "production_art_only": { "const": true },
    "runtime_ready": { "const": false }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
