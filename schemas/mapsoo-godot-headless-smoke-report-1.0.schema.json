{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-godot-headless-smoke-report-1.0.schema.json",
  "title": "Mapsoo Godot headless smoke report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "passed",
    "godot_version",
    "world_id",
    "pack_sha256",
    "runtime_artifact_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "godot-headless-smoke-report" },
    "passed": { "const": true },
    "godot_version": {
      "type": "string",
      "pattern": "^(?:4|[5-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "world_id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pack_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "character_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "profile_revision_id",
        "revision_sha256",
        "atlas_sha256"
      ],
      "properties": {
        "status": { "const": "bound" },
        "profile_revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "revision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "atlas_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
