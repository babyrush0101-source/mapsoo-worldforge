{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-pack-0.9.schema.json",
  "title": "Mapsoo Pack 0.9",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack", "profile", "completeness_policy", "compatibility", "layers", "atlases", "planes", "roles", "characters", "runtime", "files", "license", "provenance"],
  "properties": {
    "schema_version": { "const": "0.9.0" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version", "generator", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "version": { "const": "0.1.0-alpha.12" },
        "generator": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "Mapsoo Worldsmith" }, "version": { "const": "0.1.0-alpha.12" } } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "profile": { "const": "layered-depth-2d" },
    "completeness_policy": { "const": "layered-depth-2d-complete-v1" },
    "compatibility": { "type": "object" },
    "layers": { "type": "array", "minItems": 7, "maxItems": 7 },
    "atlases": { "type": "array", "minItems": 7, "maxItems": 7 },
    "planes": { "type": "array", "minItems": 7, "maxItems": 7 },
    "roles": { "type": "array", "minItems": 36, "maxItems": 36 },
    "characters": { "type": "array", "minItems": 2, "maxItems": 2 },
    "runtime": { "type": "object" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$" },
          "media_type": { "enum": ["image/png", "application/json", "application/schema+json", "text/markdown"] },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "license": { "type": "object" },
    "provenance": { "type": "object" }
  }
}
