{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-layered-depth-navigation-0.4.schema.json",
  "title": "Mapsoo Layered Depth Navigation 0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "completeness_policy", "bounds", "spawn", "nodes", "edges", "exit_node_id"],
  "properties": {
    "schema_version": { "const": "0.4.0" },
    "profile": { "const": "layered-depth-2d" },
    "completeness_policy": { "const": "layered-depth-2d-complete-v1" },
    "bounds": { "$ref": "#/$defs/rect" },
    "spawn": { "$ref": "#/$defs/point" },
    "nodes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "kind"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "kind": { "enum": ["spawn", "route", "checkpoint", "exit"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "enum": ["walk", "jump", "drop"] }
        }
      }
    },
    "exit_node_id": { "type": "string" }
  },
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "rect": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } }
  }
}
