{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-complete-world-execution-receipt-1.0.schema.json",
  "title": "Mapsoo Complete World Execution Receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "mode",
    "session_id",
    "authorization_sha256",
    "workflow_id",
    "plan_id",
    "profile",
    "status",
    "authorized_task_ids",
    "completed_task_ids",
    "requests_started_this_session",
    "remote_request_count",
    "final_state_revision",
    "retry_policy",
    "human_art_review_required",
    "production_art_only",
    "runtime_ready"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "complete-world-execution-receipt" },
    "mode": { "const": "executed" },
    "session_id": {
      "type": "string",
      "pattern": "^world-execution-[a-f0-9]{16}$"
    },
    "authorization_sha256": { "$ref": "#/$defs/sha256" },
    "workflow_id": { "$ref": "#/$defs/id" },
    "plan_id": { "$ref": "#/$defs/id" },
    "profile": {
      "enum": [
        "side-platformer",
        "topdown-farm",
        "isometric-action",
        "layered-depth-2d"
      ]
    },
    "status": {
      "enum": ["complete", "awaiting-direction-approval", "stopped"]
    },
    "stop_reason": {
      "enum": [
        "direction-approval-required",
        "task-rejected",
        "task-uncertain"
      ]
    },
    "authorized_task_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "completed_task_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "stopped_task_id": { "$ref": "#/$defs/id" },
    "requests_started_this_session": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "remote_request_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "final_state_revision": {
      "type": "integer",
      "minimum": 1
    },
    "retry_policy": { "const": "never" },
    "human_art_review_required": { "const": true },
    "production_art_only": { "const": true },
    "runtime_ready": { "const": false }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
