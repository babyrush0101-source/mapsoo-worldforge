{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babyrush0101-source.github.io/mapsoo-kids/schemas/mapsoo-isometric-action-collision-0.3.schema.json",
  "title": "Mapsoo Isometric Action Collision 0.3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile", "completeness_policy", "bounds", "spawn", "walkable_polygon", "blockers", "hazards"],
  "properties": {
    "schema_version": { "const": "0.3.0" }, "profile": { "const": "isometric-action" },
    "completeness_policy": { "const": "isometric-action-complete-v1" },
    "bounds": { "$ref": "#/$defs/rect" }, "spawn": { "$ref": "#/$defs/point" },
    "walkable_polygon": { "type": "array", "minItems": 3, "maxItems": 16, "items": { "$ref": "#/$defs/point" } },
    "blockers": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/blocker" } },
    "hazards": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/hazard" } }
  },
  "$defs": {
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } } },
    "rect": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "blocker": { "type": "object", "additionalProperties": false, "required": ["id", "rect"], "properties": { "id": { "type": "string" }, "rect": { "$ref": "#/$defs/rect" } } },
    "hazard": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "rect"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["trap", "area"] }, "rect": { "$ref": "#/$defs/rect" } } }
  }
}
