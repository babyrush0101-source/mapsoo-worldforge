{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-production-art-pack-review-1.0.schema.json",
  "title": "Mapsoo Production Art Pack Review 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "profile",
    "plan_id",
    "base_manifest_sha256",
    "source_outputs",
    "files",
    "providers",
    "models",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "production-art-pack-review" },
    "profile": {
      "enum": ["topdown-farm", "side-platformer", "isometric-action"]
    },
    "plan_id": { "$ref": "#/$defs/id" },
    "base_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_outputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "sha256"],
        "properties": {
          "task_id": { "$ref": "#/$defs/id" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "bytes",
          "sha256",
          "width",
          "height",
          "roles",
          "source_task_ids"
        ],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "media_type": { "const": "image/png" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": { "$ref": "#/$defs/role" },
            "uniqueItems": true
          },
          "source_task_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": { "$ref": "#/$defs/id" },
            "uniqueItems": true
          }
        }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/text" },
      "uniqueItems": true
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/text" },
      "uniqueItems": true
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_art", "rights", "runtime", "raspberry_pi"],
      "properties": {
        "human_art": { "const": "pending" },
        "rights": { "const": "pending" },
        "runtime": { "const": "pending" },
        "raspberry_pi": { "const": "pending" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[A-Za-z0-9][A-Za-z0-9._+!#$&^~-]*(?:/[A-Za-z0-9][A-Za-z0-9._+!#$&^~-]*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
