{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-world-material-palette-1.0.schema.json",
  "title": "Mapsoo WorldMaterialPalette 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "palette_id",
    "profile",
    "layout",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "world-material-palette" },
    "palette_id": { "$ref": "#/$defs/id" },
    "profile": {
      "enum": [
        "side-platformer",
        "topdown-farm",
        "isometric-action",
        "layered-depth-2d"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "sha256"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material", "role", "rendering"],
        "properties": {
          "material": { "$ref": "#/$defs/id" },
          "role": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^terrain\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
          },
          "rendering": { "const": "single-cell" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
