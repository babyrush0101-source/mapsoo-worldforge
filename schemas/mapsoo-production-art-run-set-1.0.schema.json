{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.dev/schemas/mapsoo-production-art-run-set-1.0.schema.json",
  "title": "Mapsoo Production Art Run Set 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "profile", "runs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "production-art-run-set" },
    "profile": {
      "enum": [
        "side-platformer",
        "topdown-farm",
        "isometric-action",
        "layered-depth-2d"
      ]
    },
    "runs": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "^(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
      }
    }
  }
}
