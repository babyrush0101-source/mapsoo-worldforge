{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapsoo.example/schemas/mapsoo-production-art-workflow-job-1.0.schema.json",
  "title": "Mapsoo production-art workflow job 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "workflow_id",
    "profile",
    "quality",
    "request_budget",
    "world_brief_file",
    "style_bible_file",
    "environment_reference",
    "character_reference",
    "character_id",
    "private_input_binding"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": { "const": "production-art-workflow-job" },
    "workflow_id": { "$ref": "#/$defs/safeId" },
    "profile": { "$ref": "#/$defs/profile" },
    "provider": { "enum": ["openai", "spritecook"] },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "resolution": { "enum": ["1K", "2K", "4K"] },
    "quality": { "enum": ["low", "medium", "high"] },
    "request_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "world_brief_file": { "$ref": "#/$defs/localPath" },
    "style_bible_file": { "$ref": "#/$defs/localPath" },
    "character_identity_semantics_file": { "$ref": "#/$defs/localPath" },
    "world_layout_plan_file": { "$ref": "#/$defs/localPath" },
    "environment_reference": { "$ref": "#/$defs/localPath" },
    "character_reference": { "$ref": "#/$defs/localPath" },
    "character_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "private_input_binding": { "$ref": "#/$defs/privateInputBinding" },
    "approved_direction": { "$ref": "#/$defs/localPath" },
    "private_output_root": { "$ref": "#/$defs/localPath" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provider": { "const": "openai" } },
        "required": ["provider"]
      },
      "then": {
        "properties": {
          "model": false,
          "resolution": false
        }
      }
    },
    {
      "if": {
        "properties": { "model": {} },
        "required": ["model"]
      },
      "then": {
        "properties": { "provider": { "const": "spritecook" } },
        "required": ["provider"]
      }
    },
    {
      "if": {
        "properties": { "resolution": {} },
        "required": ["resolution"]
      },
      "then": {
        "properties": { "provider": { "const": "spritecook" } },
        "required": ["provider"]
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile": {
      "enum": [
        "side-platformer",
        "topdown-farm",
        "isometric-action",
        "layered-depth-2d"
      ]
    },
    "privateInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_intake_sha256",
        "seed",
        "character_identity_digest_sha256",
        "environment_reference_id",
        "character_reference_id"
      ],
      "properties": {
        "confirmed_intake_sha256": { "$ref": "#/$defs/sha256" },
        "seed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "character_identity_digest_sha256": { "$ref": "#/$defs/sha256" },
        "environment_reference_id": { "$ref": "#/$defs/safeId" },
        "character_reference_id": { "$ref": "#/$defs/safeId" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  }
}
